FLASK_SECRET_KEY=change-this-to-a-random-long-string
FLASK_DEBUG=1

# Primary AI: OpenAI (gpt-5-nano)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Secondary AI (fallback): Google Gemini
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Enable Qwen2.5 Local LLM (offline AI, ~3GB model)
# Set to 1 to enable, 0 or unset to disable
# When enabled, Qwen will be used as fallback instead of basic NLP
ENABLE_LOCAL_LLM=0
